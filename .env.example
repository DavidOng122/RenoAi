# Qwen AI
QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-vl-flash

# Optional: leave blank to use QWEN_MODEL
QWEN_REPAIR_MODEL=

# Use real Qwen
AI_DEMO_MODE=false


# Google login (Auth.js)
AUTH_SECRET=generate_a_long_random_secret_here
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret


# Daytona: pricing data validation sandbox
DAYTONA_API_KEY=your_daytona_api_key
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us


# Nosana: future background video-evidence worker
NOSANA_API_KEY=your_nosana_api_key


# Future Supabase Storage setup — leave blank until implemented
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=