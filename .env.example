# Qwen (DashScope OpenAI-compatible API). The public Singapore endpoint does not need a Workspace ID.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-vl-flash

# Optional. Defaults to QWEN_MODEL when omitted.
QWEN_REPAIR_MODEL=

# Keep true until the Qwen API key is configured.
AI_DEMO_MODE=true

# Auth.js + Google OAuth
# Google Cloud redirect URI for local development:
# http://localhost:3000/api/auth/callback/google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
