# Qwen / DashScope — Singapore shared public endpoint
QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-vl-flash

# Optional: leave blank to use QWEN_MODEL
QWEN_REPAIR_MODEL=

# Use real Qwen
AI_DEMO_MODE=false


# Google OAuth / Auth.js
AUTH_SECRET=generate_a_long_random_secret_here
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret


# Daytona — required only for the pricing validation script
DAYTONA_API_KEY=your_daytona_api_key
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# Optional: defaults are already built into the validation script
DAYTONA_REPO_URL=https://github.com/DavidOng122/RenoAi.git
DAYTONA_REPO_BRANCH=main


# Nosana — future video-evidence worker
NOSANA_API_KEY=your_nosana_api_key


# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
